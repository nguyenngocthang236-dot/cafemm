@{
    // Trang quản trị dùng layout riêng (không dùng _KhachLayout của phần khách)
    Layout = null;
    ViewData["Title"] = "Dashboard quản lý đơn hàng";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1280, initial-scale=1" />
    <title>@ViewData["Title"] - binhminh</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700;800&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>

    <!-- ========== HEADER: nền gradient bình minh, menu điều hướng, avatar ========== -->
    <header class="dh-header">
        <div class="dh-header__trong">

            <a class="dh-logo" href="@Url.Action("Dashboard", "QuanLy")">
                <!-- Logo mặt trời nửa vòng, có tia -->
                <svg viewBox="0 0 32 32" aria-hidden="true" class="dh-logo__icon">
                    <path d="M6 22a10 10 0 0 1 20 0z" fill="#F6B26B" />
                    <path d="M16 5v3M6.5 9l2 2M25.5 9l-2 2M3 13h3M26 13h3" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" />
                </svg>
                <span>binhminh</span>
            </a>

            <nav class="dh-nav" aria-label="Điều hướng quản trị">
                <a href="#" class="dh-nav__muc dh-nav__muc--dang-chon" data-trang="thong-ke">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10M12 20V4M20 20v-7" /></svg>
                    Thống kê
                </a>
                <a href="#" class="dh-nav__muc" data-trang="kho">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-6 9 6v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z" /><path d="M9 20v-7h6v7" /></svg>
                    Quản lý kho
                </a>
                <a href="#" class="dh-nav__muc" data-trang="loai">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="1.5" /><rect x="13" y="3" width="8" height="8" rx="1.5" /><rect x="3" y="13" width="8" height="8" rx="1.5" /><rect x="13" y="13" width="8" height="8" rx="1.5" /></svg>
                    Quản lý loại
                </a>
            </nav>

            <div class="dh-header__phai">
                <button type="button" class="dh-icon-nut" title="Cài đặt" aria-label="Cài đặt">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1.08-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1.08 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
                </button>

                <button type="button" class="dh-icon-nut" id="nut-chuong" title="Thông báo" aria-label="Thông báo">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" /></svg>
                    <span class="dh-cham-do" aria-hidden="true"></span>
                </button>

                <button type="button" class="dh-avatar" id="nut-avatar" aria-haspopup="true" aria-expanded="false">
                    <span class="dh-avatar__anh" aria-hidden="true">A</span>
                    <span class="dh-avatar__chu">
                        <span class="dh-avatar__ten">Admin</span>
                        <span class="dh-avatar__vaitro">Admin</span>
                    </span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="dh-avatar__mui-ten"><path d="M6 9l6 6 6-6" /></svg>
                </button>
                <div class="dh-dropdown" id="dropdown-avatar" hidden>
                    <button type="button" data-hanh-dong="ho-so">Hồ sơ</button>
                    <button type="button" data-hanh-dong="dang-xuat">Đăng xuất</button>
                </div>
            </div>
        </div>
    </header>

    <!-- ========== NỘI DUNG CHÍNH: 2 cột trên nền xám nhạt ========== -->
    <main class="dh-noi-dung">
        <div class="dh-luoi">

            <!-- ---------- CỘT TRÁI: Quản lý đơn hàng ---------- -->
            <section class="the the--don-hang">
                <div class="the__dau">
                    <h1 class="the__tieu-de">Quản lý đơn hàng</h1>

                    <div class="bo-loc" role="tablist" aria-label="Lọc đơn hàng theo trạng thái">
                        <button type="button" class="bo-loc__nut bo-loc__nut--dang-chon" data-loc="tat-ca" role="tab" aria-selected="true">Tất cả</button>
                        <button type="button" class="bo-loc__nut" data-loc="cho" role="tab" aria-selected="false">Đang chờ</button>
                        <button type="button" class="bo-loc__nut" data-loc="chuan-bi" role="tab" aria-selected="false">Đang chuẩn bị</button>
                        <button type="button" class="bo-loc__nut" data-loc="san-sang" role="tab" aria-selected="false">Sẵn sàng giao</button>
                        <button type="button" class="bo-loc__nut" data-loc="hoan-tat" role="tab" aria-selected="false">Đã hoàn tất</button>
                    </div>
                </div>

                <!-- Hàng tiêu đề 4 cột (kanban ngang) -->
                <div class="don-bang-dau" aria-hidden="true">
                    <div class="don-bang-dau__o don-bang-dau__o--thong-tin">Thông tin đơn</div>
                    <div class="don-bang-dau__o don-bang-dau__o--cho">Đang chờ</div>
                    <div class="don-bang-dau__o don-bang-dau__o--chuan-bi">Đang chuẩn bị</div>
                    <div class="don-bang-dau__o don-bang-dau__o--tac-vu">Tác vụ</div>
                </div>

                <!-- Danh sách đơn hàng - JS render vào đây (xem dashboard.js: renderDanhSachDon) -->
                <div id="danh-sach-don" class="don-danh-sach"></div>

                <!-- Hiện khi bộ lọc hiện tại không có đơn nào -->
                <p id="don-rong" class="don-rong" hidden>Chưa có đơn nào ở trạng thái này.</p>
            </section>

            <!-- ---------- CỘT PHẢI: Các tác vụ khác ---------- -->
            <aside class="the the--tac-vu">
                <div class="the-tac-vu__dau">
                    <h2>Các tác vụ khác</h2>
                    <div class="the-tac-vu__mat-troi" aria-hidden="true"></div>
                </div>

                <div class="the-tac-vu__ds">
                    <button type="button" class="nut-tac-vu" id="nut-cap-nhat-thuc-don">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4z" /></svg>
                        Cập nhật thực đơn
                    </button>

                    <a class="nut-tac-vu" href="@Url.Action("DanhSachQr", "Ban")" target="_blank" rel="noopener">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><path d="M14 14h3v3M21 14v.01M14 21h.01M17 21h4v-4" /></svg>
                        Mã QR các bàn
                    </a>

                    <button type="button" class="nut-tac-vu" id="nut-sale-theo-ngay">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8z"/></svg>
                        Sale theo ngày
                    </button>

                    <a class="nut-tac-vu" href="@Url.Action("Index", "Revenue")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 17l6-6 4 4 7-8" /><path d="M14 7h7v7" /></svg>
                        Xem doanh thu hôm nay
                    </a>

                    <button type="button" class="nut-tac-vu" data-thong-bao="Tính năng kiểm tra kho đang được phát triển.">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8l-9-5-9 5 9 5 9-5z" /><path d="M3 8v8l9 5 9-5V8" /><path d="M12 13v8" /></svg>
                        Kiểm tra kho hàng
                    </button>

                    <button type="button" class="nut-tac-vu" data-thong-bao="Yêu cầu hỗ trợ đã được ghi nhận, bộ phận kỹ thuật sẽ liên hệ sớm.">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5 8.4 8.4 0 0 1-3.5-.75L3 20l1.07-4.17A8.5 8.5 0 1 1 21 11.5z" /><path d="M9.5 9a2.5 2.5 0 0 1 4.6-1.5c.5.9.1 1.5-.6 2.1-.6.5-1 .9-1 1.9" /><path d="M12 15h.01" /></svg>
                        Yêu cầu hỗ trợ
                        <svg class="nut-tac-vu__sao" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8z" /></svg>
                    </button>
                </div>
            </aside>
        </div>
    </main>

    <!-- ========== MODAL: Thêm / sửa món ========== -->
    <div class="modal-nen" id="modal-mon" hidden>
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-mon-tieu-de">
            <div class="modal__dau">
                <h2 id="modal-mon-tieu-de">Thêm / sửa món</h2>
                <button type="button" class="modal__dong" id="nut-dong-modal" aria-label="Đóng">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                </button>
            </div>

            <div class="modal__than">
                <!-- Danh sách món hiện có: bấm vào để sửa -->
                <div class="mon-ds-nho" id="mon-ds-nho" aria-label="Danh sách món hiện có"></div>

                <form id="form-mon" novalidate>
                    <input type="hidden" id="mon-id" />

                    <div class="modal__luoi">
                        <!-- Khu vực tải ảnh -->
                        <div class="truong-anh">
                            <label>Ảnh món</label>
                            <div class="vung-tha-anh" id="vung-tha-anh" tabindex="0" role="button" aria-label="Chọn hoặc kéo thả ảnh món">
                                <img id="xem-truoc-anh" alt="Ảnh xem trước" hidden />
                                <div class="vung-tha-anh__trong" id="vung-tha-anh-trong">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 16l4.6-4.6a2 2 0 0 1 2.8 0L16 16" /><path d="M14 14l1.6-1.6a2 2 0 0 1 2.8 0L21 15" /><rect x="3" y="3" width="18" height="18" rx="3" /><circle cx="8.5" cy="8.5" r="1.5" /></svg>
                                    <p>Kéo thả ảnh vào đây hoặc <span class="vung-tha-anh__bam">bấm để chọn file</span></p>
                                    <p class="vung-tha-anh__ghi-chu">JPG, PNG, WEBP · tối đa 2MB</p>
                                </div>
                            </div>
                            <input type="file" id="chon-file-anh" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" hidden />
                            <p class="truong-anh__loi" id="loi-anh" hidden></p>
                            <div class="truong-anh__nut" id="truong-anh-nut" hidden>
                                <button type="button" class="nut-nho" id="nut-doi-anh">Đổi ảnh</button>
                                <button type="button" class="nut-nho nut-nho--canh-bao" id="nut-xoa-anh">Xóa ảnh</button>
                            </div>
                        </div>

                        <!-- Các trường thông tin món -->
                        <div class="truong-thong-tin">
                            <div class="truong">
                                <label for="mon-ten">Tên món</label>
                                <input type="text" id="mon-ten" maxlength="100" required placeholder="Ví dụ: Cà phê muối" />
                            </div>
                            <div class="truong">
                                <label for="mon-gia">Giá (đ)</label>
                                <input type="number" id="mon-gia" min="0" step="1000" required placeholder="Ví dụ: 32000" />
                            </div>
                            <div class="truong">
                                <label for="mon-loai">Loại</label>
                                <select id="mon-loai">
                                    <option value="Cà phê">Cà phê</option>
                                    <option value="Trà">Trà</option>
                                    <option value="Sinh tố">Sinh tố</option>
                                    <option value="Trà sữa">Trà sữa</option>
                                    <option value="Matcha">Matcha</option>
                                </select>
                            </div>
                            <div class="truong">
                                <label for="mon-mota">Mô tả (hiện ở trang chi tiết món của khách)</label>
                                <textarea id="mon-mota" rows="3" maxlength="1000" placeholder="Ví dụ: Cà phê đậm vị, thêm lớp kem muối béo nhẹ"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="modal__chan">
                        <button type="button" class="nut-chan nut-chan--phu" id="nut-xoa-mon" hidden>Xóa món</button>
                        <div class="modal__chan-phai">
                            <button type="button" class="nut-chan nut-chan--vien" id="nut-tao-moi">Thêm món mới</button>
                            <button type="submit" class="nut-chan nut-chan--chinh">Lưu món</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ========== MODAL: Sale theo ngày ========== -->
    <div class="modal-nen" id="modal-sale" hidden>
        <div class="modal modal--sale" role="dialog" aria-modal="true" aria-labelledby="modal-sale-tieu-de">
            <div class="modal__dau">
                <h2 id="modal-sale-tieu-de">Sale theo ngày</h2>
                <button type="button" class="modal__dong" id="nut-dong-modal-sale" aria-label="Đóng">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                </button>
            </div>

            <div class="modal__than">
                <!-- Danh sách món để chọn -->
                <div class="mon-ds-nho" id="sale-mon-ds" aria-label="Chọn món muốn sale"></div>

                <form id="form-sale" novalidate>
                    <input type="hidden" id="sale-id" />
                    <input type="hidden" id="sale-sp-id" />

                    <!-- Tên món đang chọn -->
                    <div class="sale-mon-dang-chon" id="sale-mon-dang-chon" hidden>
                        <span class="sale-mon-dang-chon__icon">☕</span>
                        <span id="sale-ten-mon">—</span>
                        <span class="sale-mon-dang-chon__gia" id="sale-gia-goc"></span>
                    </div>

                    <!-- Layout 2 cột: Bắt đầu | Kết thúc -->
                    <div class="sale-thoi-gian-luoi">

                        <!-- Bên trái: Bắt đầu sale -->
                        <div class="sale-thoi-gian-o sale-thoi-gian-o--bat-dau">
                            <div class="sale-thoi-gian-o__nhan">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="sale-thoi-gian-o__icon"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                                Bắt đầu sale
                            </div>
                            <div class="sale-thoi-gian-o__khung">
                                <input type="datetime-local" id="sale-bat-dau" class="sale-thoi-gian-input" required step="1" />
                            </div>
                        </div>

                        <!-- Dấu mũi tên giữa -->
                        <div class="sale-thoi-gian-mui-ten" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                        </div>

                        <!-- Bên phải: Kết thúc sale -->
                        <div class="sale-thoi-gian-o sale-thoi-gian-o--ket-thuc">
                            <div class="sale-thoi-gian-o__nhan">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="sale-thoi-gian-o__icon sale-thoi-gian-o__icon--do"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
                                Kết thúc sale
                            </div>
                            <div class="sale-thoi-gian-o__khung sale-thoi-gian-o__khung--do">
                                <input type="datetime-local" id="sale-ket-thuc" class="sale-thoi-gian-input" required step="1" />
                            </div>
                        </div>
                    </div>

                    <!-- Phần trăm giảm -->
                    <div class="truong">
                        <label for="sale-phan-tram">Giảm giá (%)</label>
                        <div class="sale-phan-tram-wrap">
                            <input type="number" id="sale-phan-tram" min="1" max="100" step="1" required placeholder="Ví dụ: 20" />
                            <span class="sale-phan-tram-dvt">%</span>
                            <span class="sale-phan-tram-xem-truoc" id="sale-xem-truoc-gia"></span>
                        </div>
                    </div>

                    <!-- Danh sách sale hiện tại -->
                    <div class="sale-ds-hien-tai" id="sale-ds-hien-tai" hidden>
                        <h3 class="sale-ds-tieu-de">Các chương trình sale đang có</h3>
                        <div id="sale-ds-the"></div>
                    </div>

                    <div class="modal__chan">
                        <button type="button" class="nut-chan nut-chan--canh-bao" id="nut-xoa-sale" hidden>Xóa sale</button>
                        <div class="modal__chan-phai">
                            <button type="button" class="nut-chan nut-chan--vien" id="nut-tao-sale-moi">Tạo sale mới</button>
                            <button type="submit" class="nut-chan nut-chan--chinh">Lưu sale</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script src="~/js/dashboard.js" asp-append-version="true"></script>
</body>
</html>
